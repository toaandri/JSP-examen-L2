<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><c:out value="${pageTitle}" /></title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/tinder.css" />
</head>
<body>
<div class="topbar">
    <div class="brand">tinderish</div>
    <div class="topbarRight">
        <c:if test="${not empty sessionScope.userId}">
            <a class="topLink" href="${pageContext.request.contextPath}/app/swipe">Swipe</a>
            <a class="topLink" href="${pageContext.request.contextPath}/app/matches">Matches</a>
            <a class="topLink" href="${pageContext.request.contextPath}/app/notifications">Notif</a>
            <a class="topLink" href="${pageContext.request.contextPath}/app/settings">Profil</a>
            <form class="logoutForm" method="post" action="${pageContext.request.contextPath}/auth/logout">
                <button class="ghostBtn" type="submit">Logout</button>
            </form>
        </c:if>
    </div>
</div>

<main class="container">
    <c:if test="${not empty error}">
        <div class="alert alertError"><c:out value="${error}" /></div>
    </c:if>
    <c:if test="${not empty success}">
        <div class="alert alertSuccess"><c:out value="${success}" /></div>
    </c:if>

